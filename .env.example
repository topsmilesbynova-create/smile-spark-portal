# Copy to .env.local for local overrides. Only VITE_* variables reach the browser,
# so never put secrets in this file.

# Base URL of the NestJS API, including any global prefix, without a trailing slash.
# Leave empty to run against the in-browser mock API with fictional demo data.
# Keep it empty for now: setting it switches every screen to the API, which does not
# serve bookings yet. Staff sign-in still calls http://localhost:3000/api when this is
# empty. Use /dev/api-health (dev only) to check connectivity.
# Example: VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_BASE_URL=
